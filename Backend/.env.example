# Secret used to sign auth JWTs — set to a long random string.
JWT_SECRET=nightmare

# Optional overrides (sensible defaults are used if unset):
# SCROLLSENSE_DB_PATH=./scrollsense.db
# SCROLLSENSE_CHECKPOINT_DIR=../Processor/checkpoints/best_model

# CORS: comma-separated list of allowed frontend origins.
# Defaults to "*" (any origin) for local dev. Lock this down in production, e.g.
# SCROLLSENSE_ALLOWED_ORIGINS=https://app.scrollsense.com,chrome-extension://<id>
# SCROLLSENSE_ALLOWED_ORIGINS=*
