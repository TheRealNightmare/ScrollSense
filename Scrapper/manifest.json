{
  "manifest_version": 3,
  "name": "ScrollSense",
  "version": "1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.facebook.com/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"]
    }
  ]
}